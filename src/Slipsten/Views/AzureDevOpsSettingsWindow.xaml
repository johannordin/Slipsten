<Window x:Class="Slipsten.Views.AzureDevOpsSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Azure DevOps Settings — Slipsten">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <TextBlock Text="Azure DevOps Settings" VerticalAlignment="Center" Margin="16,0,0,0"
                       Style="{StaticResource CaptionTextBlockStyle}"/>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="20,8,20,16">
            <StackPanel Spacing="4">
                <CheckBox x:Name="AzureDevOpsEnabledCheck" Content="Show my in-progress Azure DevOps work items in the floating bar"/>

                <TextBlock x:Name="AzureDevOpsSummaryText"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>

                <TextBlock Text="Organization URL" FontSize="12" Margin="0,8,0,2"/>
                <TextBox x:Name="AzureDevOpsOrganizationBox" Width="420" PlaceholderText="(use az devops defaults)"/>

                <TextBlock Text="Project" FontSize="12" Margin="0,8,0,2"/>
                <TextBox x:Name="AzureDevOpsProjectBox" Width="260" PlaceholderText="(use az devops defaults)"/>

                <TextBlock Text="States that count as in progress" FontSize="12" Margin="0,8,0,2"/>
                <TextBox x:Name="AzureDevOpsStatesBox" Width="420" PlaceholderText="New, Committed, To Do, In Progress"/>

                <TextBlock Text="Work item types to include" FontSize="12" Margin="0,8,0,2"/>
                <TextBox x:Name="AzureDevOpsWorkItemTypesBox" Width="420" PlaceholderText="Product Backlog Item, Task, Bug"/>

                <TextBlock Text="Poll interval (seconds)" FontSize="12" Margin="0,8,0,2"/>
                <TextBox x:Name="AzureDevOpsPollIntervalBox" Width="120"/>

                <TextBlock Text="Uses the signed-in `az` CLI session. Leave organization/project blank to use `az devops` defaults."
                           FontSize="11" Margin="0,6,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="20,0,20,20" Padding="0,12,0,0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Button Content="Cancel" Click="Cancel_Click"/>
            <Button Content="Save" Click="Save_Click" Style="{StaticResource AccentButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
