<Window x:Class="Slipsten.Views.GitHubSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitHub Watch Setup — Slipsten">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <TextBlock Text="GitHub Watch Setup" VerticalAlignment="Center" Margin="16,0,0,0"
                       Style="{StaticResource CaptionTextBlockStyle}"/>
        </Grid>

        <Grid Grid.Row="1" Padding="16,8,16,16" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="GitHub Personal Access Token"/>
                <TextBox Grid.Row="1" x:Name="PatBox" PlaceholderText="Paste PAT with repo/actions/team read access" Margin="0,8,0,0"/>

                <TextBlock Grid.Row="2" Text="PR/review poll interval (seconds)" Margin="0,12,0,0"/>
                <TextBox Grid.Row="3" x:Name="PrPollIntervalBox" Margin="0,8,0,0"/>

                <TextBlock Grid.Row="4" Text="CI poll interval (seconds)" Margin="0,12,0,0"/>
                <TextBox Grid.Row="5" x:Name="CiPollIntervalBox" Margin="0,8,0,0"/>

                <StackPanel Grid.Row="6" Spacing="8" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Save access" Click="SaveAccess_Click"/>
                    <Button Content="Refresh repos" Click="RefreshRepos_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="StatusText"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"/>

                    <TextBlock Text="Private repositories" Margin="0,8,0,0" FontWeight="SemiBold"/>
                    <ListView x:Name="RepoList"
                           SelectionChanged="RepoList_SelectionChanged"
                           MinHeight="0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" TextWrapping="WrapWholeWords"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="1">
                <TextBlock x:Name="NoRepoSelectedText"
                           Text="Select a repository from the list to configure it."
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>

                <Grid x:Name="RepoDetailsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="SelectedRepoText" Text="Select a repository" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SelectedRepoHint"
                               Grid.Row="1"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>

                    <CheckBox x:Name="WatchMyPrsCheck" Grid.Row="2" Content="Show my PRs from this repository" Margin="0,12,0,0"/>
                    <CheckBox x:Name="WatchCiFailuresCheck" Grid.Row="3" Content="Watch CI failures" Margin="0,6,0,0"/>

                    <TextBlock Grid.Row="4" Text="Workflows" Margin="0,12,0,0" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="5" Text="If none are selected, all workflows in the repository are watched for CI failures."
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>

                    <Grid Grid.Row="6" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="WorkflowFilterBox"
                              PlaceholderText="Filter workflows..."
                              TextChanged="WorkflowFilterBox_TextChanged"/>
                        <ListView x:Name="WorkflowList" Grid.Row="1" Margin="0,8,0,0" SelectionMode="None" MinHeight="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="16,0,16,16">
            <Button x:Name="SaveRepoWatchButton" Content="Save repo watch" Click="SaveRepoWatch_Click" Style="{StaticResource AccentButtonStyle}" IsEnabled="False"/>
            <Button x:Name="RemoveRepoWatchButton" Content="Remove repo watch" Click="RemoveRepoWatch_Click" IsEnabled="False"/>
            <Button Content="Close" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
