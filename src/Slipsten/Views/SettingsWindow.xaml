<Window x:Class="Slipsten.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — Slipsten">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <TextBlock Text="Settings" VerticalAlignment="Center" Margin="16,0,0,0"
                       Style="{StaticResource CaptionTextBlockStyle}"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" Padding="20,4,20,20">
                <StackPanel Spacing="4">
                    <TextBlock Text="Database path" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBox x:Name="DbPathBox" Width="340" PlaceholderText="(default location)"/>
                        <Button Content="Browse..." Click="BrowseDbPath_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="ResolvedPathText" FontSize="11" Margin="0,2,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>

                    <TextBlock Text="Idle threshold (seconds)" Margin="0,12,0,4"/>
                    <TextBox x:Name="IdleThresholdBox"/>

                    <TextBlock Text="Phone reminders" Margin="0,16,0,4"
                               FontWeight="SemiBold"/>
                    <CheckBox x:Name="PhoneAlertsEnabledCheck" Content="Send month-end reminder to my phone"/>
                    <TextBlock Text="Provider" FontSize="12" Margin="0,4,0,2"/>
                    <TextBox x:Name="PhoneAlertProviderBox" Width="160" IsReadOnly="True"/>
                    <TextBlock Text="ntfy topic" FontSize="12" Margin="0,4,0,2"/>
                    <TextBox x:Name="NtfyTopicBox" Width="340" PlaceholderText="my-secret-slipsten-topic"/>
                    <TextBlock Text="ntfy server URL" FontSize="12" Margin="0,4,0,2"/>
                    <TextBox x:Name="NtfyServerUrlBox" Width="340" PlaceholderText="https://ntfy.sh"/>
                    <TextBlock Text="ntfy access token (optional)" FontSize="12" Margin="0,4,0,2"/>
                    <TextBox x:Name="NtfyAccessTokenBox" Width="340"/>
                    <TextBlock Text="Reminder is sent once on the last day of the month after 12:00."
                               FontSize="11" Margin="0,4,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>

                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="20,0,20,20" Padding="0,12,0,0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <Button Content="Import Grindstone..." Click="Import_Click"/>
                <Button Content="Cancel" Click="Cancel_Click"/>
                <Button Content="Save" Click="Save_Click"
                        Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
