<Window x:Class="Slipsten.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Slipsten">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <TextBlock Text="Slipsten" VerticalAlignment="Center" Margin="16,0,0,0"
                       Style="{StaticResource CaptionTextBlockStyle}"/>
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="1" Padding="16,4,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Date navigation -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                    <Button Content="◀" Click="PrevDay_Click" Width="30"/>
                    <TextBlock x:Name="DateLabel" VerticalAlignment="Center" Margin="4,0"
                               FontSize="14"/>
                    <Button Content="▶" Click="NextDay_Click" Width="30"/>
                    <Button Content="Today" Click="Today_Click" Margin="4,0,0,0"/>
                    <TextBlock x:Name="DayTotal" VerticalAlignment="Center" Margin="4,0,0,0"
                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button x:Name="StartStopButton" Click="StartStop_Click"/>
                </StackPanel>
            </Grid>

            <!-- Entry list with column headers -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="12,6,12,6"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      CornerRadius="4,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Start" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="End" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Column="2" Text="Duration" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Column="3" Text="2×" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Column="4" Text="Description" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>

                <ListView Grid.Row="1" x:Name="EntryList" SelectionChanged="EntryList_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="4,0,4,0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4,2,4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Start}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding End}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Duration}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="3" IsChecked="{Binding IsDoublePay, Mode=OneWay}"
                                          Click="DoublePay_Click" MinWidth="0"/>
                                <TextBlock Grid.Column="4" Text="{Binding Description}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Edit panel (shown when an entry is selected) -->
            <Border Grid.Row="2" x:Name="EditPanel" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12,8,12,8" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Start" VerticalAlignment="Center"/>
                        <TextBox x:Name="StartBox" Width="60"/>
                        <TextBlock Text="End" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <TextBox x:Name="EndBox" Width="60"/>
                        <Button Content="Save" Click="SaveEdit_Click" Margin="6,0,0,0"
                                Style="{StaticResource AccentButtonStyle}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Click="DeleteEntry_Click" ToolTipService.ToolTip="Delete entry"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                        <SymbolIcon Symbol="Delete"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
