<Window x:Class="Slipsten.Views.FloatingBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Slipsten">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Entire window is the drag region via title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0"/>

        <!-- Content overlaid on the title bar drag region -->
        <Grid Grid.Row="0" Padding="6,0,6,0" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="StartStopButton" Grid.Column="0" Click="StartStop_Click"
                    VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0"
                    Padding="2" MinWidth="0" MinHeight="0"
                    ToolTipService.ToolTip="Start or stop timer">
                <FontIcon x:Name="StartStopIcon" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="15"/>
            </Button>

            <Button x:Name="TimeButton" Grid.Column="1" Click="Time_Click"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Background="Transparent" BorderThickness="0" Padding="2"
                    MinWidth="0">
                <TextBlock x:Name="TotalTimeText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Button>

            <!-- Dynamic CLI widgets panel -->
            <ItemsControl x:Name="WidgetsPanel" Grid.Column="2">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Button x:Name="MenuButton" Grid.Column="3" Click="Menu_Click"
                    VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                    Padding="2" MinWidth="0" MinHeight="0"
                    ToolTipService.ToolTip="Menu">
                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="15" Glyph="&#xE700;"/>
                <Button.Flyout>
                    <MenuFlyout x:Name="AppMenuFlyout">
                        <MenuFlyoutItem Text="Todays time" Click="TodaysTime_Click"/>
                        <MenuFlyoutItem Text="Month summary" Click="MonthSummary_Click"/>
                        <MenuFlyoutItem Text="Settings" Click="Settings_Click"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Exit" Click="Exit_Click"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <Grid.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Minimize to tray" Click="Minimize_Click">
                        <MenuFlyoutItem.Icon>
                            <SymbolIcon Symbol="Remove"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Grid.ContextFlyout>
        </Grid>
    </Grid>
</Window>
