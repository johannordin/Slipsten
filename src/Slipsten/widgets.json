{
  "variables": {
    "githubOwner": "",
    "azureOrg": "",
    "azureProject": ""
  },
  "cliWidgets": [
    {
      "id": "blue-demo",
      "tooltip": "Demo blue widget",
      "refreshSeconds": 60,
      "command": "echo []",
      "badge": {
        "text": "🔵 {array.length}",
        "color": "#2563EB"
      },
      "flyout": {
        "displayTemplate": "{id} {name} ({status})",
        "urlTemplate": "https://github.com/MyRepo/pulls/{id}",
        "emptyMessage": "No items"
      }
    },
    {
      "id": "green-demo",
      "tooltip": "Demo green widget",
